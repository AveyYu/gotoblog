---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Post from "@/components/Blog/Post.astro";

const posts = await Astro.glob("@/pages/posts/*.md");
const pageTitle = "Blog";

const cmp = (a: any, b: any) => {
  if (a.frontmatter.pubDate > b.frontmatter.pubDate) {
    return -1;
  }
  return 1;
};

posts.sort(cmp);

// 💡 修正一：将这部分 JavaScript 代码移入到了 --- 内部，使其成为合法的 Astro 头部代码
const postsByYear: Record<string, any[]> = {};
posts.forEach((post) => {
  const dateStr = post.frontmatter.pubDate;
  const year = dateStr ? new Date(dateStr).getFullYear().toString() : "其它";
  if (!postsByYear[year]) {
    postsByYear[year] = [];
  }
  postsByYear[year].push(post);
});

const years = Object.keys(postsByYear).sort((a, b) => b.localeCompare(a));
---

<!-- 完美保留了您所有的自定义样式（如 text-4xl, gap-4, mb-8） -->
<BaseLayout pageTitle={pageTitle}>
  <div class="flex flex-col gap-4">
    <div class="text-4xl text-stone-700 dark:text-stone-200 font-bold mb-8">
      OKGOWILD
    </div>
  
    <div class="flex flex-col gap-10">
      {
        years.map((year) => (
          <div class="flex flex-col gap-4">
            <!-- 年份分栏线 -->
            <div class="flex items-center gap-4 text-xl font-bold text-stone-700 dark:text-stone-300 mt-4 mb-2">
              <span class="shrink-0">{year}</span>
              <div class="grow border-t border-dashed border-stone-300 dark:border-stone-700"></div>
            </div>
            
            <!-- 文章列表 -->
            {postsByYear[year].map((post) => (
              <Post
                url={post.url as string}
                path={post.file}
                title={post.frontmatter.title}
                /* 💡 修正二：补上了 desc，以通过 TypeScript 的强制接口校验，且不展示描述内容 */
                desc={post.frontmatter.description}
                date={post.frontmatter.pubDate}
                tags={post.frontmatter.tags}
              />
            ))}
          </div>
        ))
      }
    </div>
  </div> <!-- 💡 修正三：补上了这行原本缺失的闭合 </div> 标签 -->
</BaseLayout>
