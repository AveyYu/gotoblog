---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { urlFromBase } from "@/lib/utils";

const posts: any = await Astro.glob("@/pages/posts/*.md");
const unique = [
  ...new Set(posts.map((post: any) => post.frontmatter.tags).flat()),
];
interface Props {
  tag: string;
}

const base = import.meta.env.BASE_URL;
---

<BaseLayout>
  <div class="text-4xl mb-16 text-stone-700 dark:text-stone-200 font-bold">
    TAGS
  </div>
  <div
    class="flex flex-wrap justify-center w-full mx-auto gap-6 nobloger-animate transition-opacity duration-300 ease-in-out opacity-0"
  >
    {
      unique.map((tag: any) => (
        <a
          href={urlFromBase(base, "tags/" + tag)}
          class="text-base rounded-md bg-stone-200 dark:bg-stone-700 text-stone-600 dark:text-stone-300 px-3 py-1 hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out"
        >
          #{tag}
        </a>
      ))
    }
  </div>
</BaseLayout>
