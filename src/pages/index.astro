---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Content as Selfie } from "#/selfie.md";

const pageTitle = "OKGOWILD";
---

<BaseLayout pageTitle={pageTitle}>
  <div class="flex flex-col gap-4">
    <div class="text-4xl mb-8 text-stone-700 dark:text-stone-200 font-bold">
      OKGOWILD
    </div>

    <div
      class="nobloger-animate transition-opacity duration-300 ease-in-out opacity-0"
    >
      <article
        class="prose dark:prose-invert prose-stone md:prose-lg prose-h1:text-3xl prose-h2:text-2xl prose-h3:text-xl"
      >
        <Selfie />
      </article>
    </div>
  </div>
</BaseLayout>
