---
import BaseLayout from "./BaseLayout.astro";
import Ztag from "@/components/Blog/Ztag.astro";
const { frontmatter } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title} description={frontmatter.description}>
  <div class="text-stone-800 dark:text-stone-200">
    <div class="py-2">
      <div class="font-black text-4xl mb-6">
        {frontmatter.title}
      </div>
      <div class="mb-4 font-thin text-stone-600 dark:text-stone-400">
        Publish on {(frontmatter.pubDate ?? "").split("T")[0]}
      </div>
      <!-- 将底部的 mb-8 改回 mb-6，为虚线留出对称的距离 -->
      <div class="flex gap-2 mb-6">
        {frontmatter.tags.map((tag: string) => <Ztag tag={tag} />)}
      </div>
      <!-- 👇 新增的虚线行，与底部版权上方虚线的粗细、样式（dashed）和两态颜色（300/700）完全一致 -->
      <div class="border-t border-dashed border-stone-300 dark:border-stone-700 my-6"></div>
    </div>
    <article
      class="prose dark:prose-invert prose-stone md:prose-lg prose-h1:text-3xl prose-h2:text-2xl prose-h3:text-xl"
    >
      <slot />
    </article>

    <!-- 融合版版权说明（英文精细缩小 & 两栏间距拉大到 gap-8） -->
    <div class="mt-12 pt-6 border-t border-dashed border-stone-300 dark:border-stone-700 text-sm text-stone-500 dark:text-stone-400 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-8 text-left">
      <!-- 左侧版权声明 -->
      <p class="leading-relaxed">
        &copy; 版权所有。未经许可，禁止转载或摘编。
        <!-- 💡 英文专属容器：字号缩小为 text-xs，设定 block 自动换行，并留有 mt-1 的微小行距 -->
        <span class="block text-xs opacity-75 mt-1">
          All rights reserved. No reproduction or redistribution without prior written permission.
        </span>
      </p>
      
      <!-- 右侧 Not by AI 徽章（间距已拉开至完美的 gap-8 宽度） -->
      <a href="https://notbyai.fyi" target="_blank" rel="noopener" class="shrink-0">
        <img 
          src="/not-by-ai.png" 
          alt="Not by AI badge" 
          class="h-9 w-auto dark:invert dark:brightness-90 transition-all duration-300"
        />
      </a>
    </div>

  </div>
</BaseLayout>
