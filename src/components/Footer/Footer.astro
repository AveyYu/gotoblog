---
import { urlFromBase } from "@/lib/utils";
import { frontmatter as Selfie } from "#/selfie.md";

const base = import.meta.env.BASE_URL;
---

<div
  class="nobloger-animate flex flex-col items-center mt-24 mb-12 text-sm text-zinc-500 dark:text-zinc-500 text-light transition-opacity duration-300 ease-in-out opacity-0 gap-2"
>
  <!-- 第一行：版权与 RSS -->
  <div class="flex flex-nowrap justify-center items-center">
    <div class="whitespace-nowrap">
      ©️OKGOWILD since 2024. All rights reserved.
    </div>
    <span class="px-2">｜</span>
    <a class="underline whitespace-nowrap" href={urlFromBase(base, "rss.xml")}
      >rss</a
    >
  </div>
  
  <!-- 第二行：样式现在与第一行完全一致 -->
  <div class="whitespace-nowrap">
    crafted with ❤️ by okgowild
  </div>
</div>
