---
import { urlFromBase } from "@/lib/utils";
interface Props {
  tag: string;
}

const base = import.meta.env.BASE_URL;
const { tag } = Astro.props;
---

<a
  href={urlFromBase(base, "tags/" + tag)}
  class="rounded bg-stone-200 dark:bg-stone-700 text-stone-600 dark:text-stone-300 text-xs px-1.5 py-0.5"
>
  #{tag}
</a>
