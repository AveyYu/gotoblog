---
import { urlFromBase } from "@/lib/utils";
interface Props {
  tag: string;
}

const base = import.meta.env.BASE_URL;
const { tag } = Astro.props;
---

<a
  href={urlFromBase(base, "tags/" + tag)}
  class="rounded bg-stone-100 dark:bg-stone-800 text-stone-500 dark:text-stone-400 text-xs px-1.5 py-0.5"
>
  #{tag}
</a>
